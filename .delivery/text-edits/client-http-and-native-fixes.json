Map<number, Food>(rows.map(row => [row.payload.version, row.payload]));\n    available.set(current.version, current);\n    return [...available.values()].sort((a, b) => b.version - a.version);\n  });\n}\n"]]},{"path":"scripts/native/android-smoke.py","oldSha256":"5c21dc725406e7bcbd4c10796c02fb395aee872d728e7e7cda77e6dc82199fdf","newSha256":"6b820ca70221ca4f05a9bc3fa5cb33f3e43b465a646649585ac31b7eac25af56","edits":[[2031,2031,", predicate=lambda node: True"],[2321,2321,") and predicate(node"],[2654,2654,", predicate=lambda item: item.get('clickable') == 'true' and item.get('enabled') != 'false'"],[5476,5477,"\n    wait_node('Alimento o ingrediente', predicate=lambda n: n.get('class') == 'android.widget.EditText' and n.get('focused') == 'true')\n   "],[5523,5523,"w"],[5524,5524,"it_no"],[5525,5526,"e"],[5528,5530,"Alim"],[5531,5533,"nto o ingrediente"],[5536,5536,"predicate=lambda n: n.get("],[5537,5537,"class') == 'andro"],[5538,5538,"d.widget.EditText' a"],[5539,5539,"d n.get('text') == 'Pechuga')\n    # Select the result directly, as a "],[5540,5540,"erson does. An "],[5541,5541,"ncondi"],[5542,5542,"ional Back pops the\n    # screen when a hardware keyboard means no software IME was opened.\n    wait_node('Pechuga de pollo asada"],[5545,5545,"predicate=lambda n: n.get("],[5546,5546,"clic"],[5547,5547,"abl"],[5548,5554,""],[5555,5556,") =="],[5558,5570,"true')\n    capture('05b-food-search"]]},{"path":"scripts/native/ios/CUKISmokeTests.swift","oldSha256":"886699256485d880a81638cc736a9239eeb0a49dd249e888f67b506fb752c3cc","newSha256":"3ce99924119b51704e175be77cfaf69a47b08e71cbbe26e0498589b60c5c100d","edits":[[2275,2275,"app.textFields.matchi"],[2276,2277,"g(i"],[2279,2280,"ntifier: "],[2304,2304,").firstMatch\n        XCTAssertTrue(search.waitForExistence(timeout: 20)"]]},{"path":"scripts/native/ios/add-ui-tests.rb","oldSha256":"afd68ff6977f2fe639d2ee4604a46e79591c91313bcd0a910f415adaa36833c1","newSha256":"2c66378320f28290a46342ca1790f415cd60bdc998fb32abfe0399e1dfbb7