{
  "name": "cuki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "expo": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-router": "~57.0.21",
    "expo-modules-core": "~57.0.18",
    "expo-asset": "~57.0.17",
    "expo-gl": "~57.0.2",
    "expo-glass-effect": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-sqlite": "~57.0.3",
    "expo-crypto": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-constants": "~57.0.18",
    "expo-camera": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-image-manipulator": "~57.0.17",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.18",
    "expo-network": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-audio": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-screens": "~4.26.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "@shopify/react-native-skia": "2.6.2",
    "@react-three/fiber": "9.7.0",
    "three": "^0.180.0",
    "@tanstack/react-query": "^5.0.0",
    "zustand": "^5.0.0",
    "react-native-purchases": "^9.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "jose": "^6.0.0",
    "zod": "^4.0.0",
    "sharp": "^0.34.0",
    "react-dom": "19.2.3",
    "@electric-sql/pglite": "0.5.8"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/three": "^0.180.0",
    "@types/pg": "^8.0.0",
    "@testing-library/react-native": "^13.0.0",
    "react-test-renderer": "19.2.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "@types/jest": "^29.5.0"
  },
  "workspaces": [
    "apps/mobile"
  ],
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "mobile": "npm run start -w @cuki/mobile",
    "api": "node --env-file-if-exists=.env --import tsx apps/api/src/index.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/index.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test:core": "node scripts/test-runner.mjs core",
    "test:integration": "node scripts/test-runner.mjs integration",
    "test:mobile": "jest --runInBand --config jest.config.cjs",
    "verify": "node scripts/verify.mjs",
    "admin": "node --env-file-if-exists=.env --import tsx apps/api/src/index.ts",
    "export:android": "npm run export:android -w @cuki/mobile",
    "export:ios": "npm run export:ios -w @cuki/mobile",
    "test": "npm run test:core && npm run test:integration && npm run test:mobile",
    "setup:local": "node scripts/bootstrap.mjs"
  }
}
